<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="620"
        x:Class="Rovia.Desktop.MainWindow"
        Width="1100" Height="760" MinWidth="820" MinHeight="580"
        Title="Rovia">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24">
    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="_Import link..." Click="ImportLinkClicked" />
        <MenuItem Header="Import _subscription..." Click="ImportSubscriptionMenuItemClicked" />
        <Separator />
        <MenuItem Header="_Delete selected connection..." Click="DeleteClicked" InputGesture="Delete" />
        <Separator />
        <MenuItem Header="_Clear log" Click="ClearLogClicked" />
        <Separator />
        <MenuItem Header="E_xit" Click="ExitClicked" />
      </MenuItem>
    </Menu>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,16,0,20">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="Rovia" FontSize="30" FontWeight="SemiBold" />
        <TextBlock Text="Adaptive proxy routing" Opacity="0.65" />
      </StackPanel>
      <Border Grid.Column="1" Background="#151D2A" CornerRadius="6" Padding="12,8" VerticalAlignment="Center" Margin="24,0,0,0">
        <TextBlock x:Name="MessageText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#151D2A" CornerRadius="10" Padding="16" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,180,140,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
          <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#EF4444" />
          <TextBlock Text="Runtime status" Opacity="0.65" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="1" Grid.Column="0" Text="Disconnected" FontSize="18" FontWeight="SemiBold" Foreground="#EF4444" />
        <TextBlock x:Name="PerformanceText" Grid.Row="2" Grid.Column="0" Text="Latency — · Download —" Margin="0,6,0,0" Opacity="0.75" />
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Local proxy 127.0.0.1:2080" Margin="0,4,0,0" Opacity="0.55" FontSize="12" />
        <StackPanel Grid.RowSpan="4" Grid.Column="1" Margin="16,0" Spacing="4">
          <TextBlock Text="Traffic mode" Opacity="0.65" />
          <ComboBox x:Name="ModeComboBox" SelectedIndex="0">
            <ComboBoxItem Content="System proxy" Tag="system-proxy" />
            <ComboBoxItem Content="TUN (administrator)" Tag="tun" />
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.RowSpan="4" Grid.Column="2" Margin="16,0" Spacing="4">
          <TextBlock Text="Log level" Opacity="0.65" />
          <ComboBox x:Name="LogLevelComboBox" SelectedIndex="2">
            <ComboBoxItem Content="Trace" Tag="trace" />
            <ComboBoxItem Content="Debug" Tag="debug" />
            <ComboBoxItem Content="Info" Tag="info" />
            <ComboBoxItem Content="Warn" Tag="warn" />
            <ComboBoxItem Content="Error" Tag="error" />
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.RowSpan="4" Grid.Column="3" Spacing="8" VerticalAlignment="Center">
          <Button Content="Refresh" Click="RefreshClicked" />
          <Button Content="Speed test" Click="SpeedTestClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="300,*" Margin="0,0,0,16">
      <Border Grid.Column="0" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
        <ListBox x:Name="NodeList" KeyDown="NodeListKeyDown">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Delete selected connection..." Click="DeleteClicked" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Margin="8">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Endpoint}" Opacity="0.6" FontSize="12" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Protocol}" VerticalAlignment="Center" Opacity="0.7" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Border Grid.Column="1" Margin="16,0,0,0" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="Connection log" FontWeight="SemiBold" Margin="12,8,12,4" />
          <ListBox Grid.Row="1" x:Name="LogList" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Time}" Opacity="0.6" FontSize="12" />
                  <TextBlock Text="{Binding Level}" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock Text="{Binding Message}" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
      <Button Content="Connect" Click="ConnectBestClicked" />
      <Button Content="Connect selected" Click="ConnectSelectedClicked" ToolTip.Tip="Connect the node selected in the list" />
      <Button Content="Disconnect" Click="DisconnectClicked" />
      <Button Content="Delete selected" Click="DeleteClicked" />
      <Button Content="Probe all" Click="ProbeClicked" />
      <Button Content="Diagnose" Click="DiagnoseClicked" />
      <Button Content="Export support ZIP" Click="ExportDiagnosticsClicked" />
    </StackPanel>
  </Grid>
</Window>
