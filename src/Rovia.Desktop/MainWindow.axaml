<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="620"
        x:Class="Rovia.Desktop.MainWindow"
        Width="920" Height="620" MinWidth="720" MinHeight="480"
        Title="Rovia">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
      <TextBlock Text="Rovia" FontSize="30" FontWeight="SemiBold" />
      <TextBlock Text="Adaptive proxy routing" Opacity="0.65" />
    </StackPanel>

    <Border Grid.Row="1" Background="#151D2A" CornerRadius="10" Padding="16" Margin="0,0,0,16">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Runtime status" Opacity="0.65" />
        <TextBlock x:Name="StatusText" Grid.Row="1" Grid.Column="0" Text="Checking…" FontSize="18" FontWeight="SemiBold" />
        <Button Grid.RowSpan="2" Grid.Column="1" Content="Refresh" Click="RefreshClicked" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <TextBox x:Name="LinkTextBox" Watermark="Paste a VLESS share link" Margin="0,0,8,0" />
        <Button Grid.Column="1" Content="Import" Click="ImportClicked" />
      </Grid>
      <Border Grid.Row="1" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
        <ListBox x:Name="NodeList">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Margin="8">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Endpoint}" Opacity="0.6" FontSize="12" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Protocol}" VerticalAlignment="Center" Opacity="0.7" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,16,0,0">
      <Button Content="Connect automatically" Click="ConnectClicked" Margin="0,0,8,0" />
      <Button Grid.Column="1" Content="Disconnect" Click="DisconnectClicked" />
      <TextBlock x:Name="MessageText" Grid.Column="2" Margin="16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="3" Text="Local proxy 127.0.0.1:2080" VerticalAlignment="Center" Opacity="0.55" />
    </Grid>
  </Grid>
</Window>
