<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.14" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.14" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.14" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.14" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rovia.Cli\Rovia.Cli.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Rovia.Backends\Rovia.Backends.csproj" />
    <ProjectReference Include="..\Rovia.Config\Rovia.Config.csproj" />
    <ProjectReference Include="..\Rovia.Platform.Windows\Rovia.Platform.Windows.csproj" />
    <ProjectReference Include="..\Rovia.Runtime\Rovia.Runtime.csproj" />
  </ItemGroup>

  <Target Name="CopyCliRuntime" AfterTargets="Build">
    <ItemGroup>
      <CliRuntimeFile Include="..\Rovia.Cli\bin\$(Configuration)\$(TargetFramework)\rovia.exe" />
      <CliRuntimeFile Include="..\Rovia.Cli\bin\$(Configuration)\$(TargetFramework)\rovia.dll" />
      <CliRuntimeFile Include="..\Rovia.Cli\bin\$(Configuration)\$(TargetFramework)\rovia.deps.json" />
      <CliRuntimeFile Include="..\Rovia.Cli\bin\$(Configuration)\$(TargetFramework)\rovia.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(CliRuntimeFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishCliRuntime" AfterTargets="Publish">
    <MSBuild Projects="..\Rovia.Cli\Rovia.Cli.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir)runtime\" />
  </Target>
</Project>
